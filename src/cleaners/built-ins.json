{
  "cleaners": [
    {
      "id": "npm",
      "name": "npm cache",
      "category": "dev-cache",
      "platforms": [
        "darwin",
        "linux",
        "win32"
      ],
      "detect": {
        "executable": "npm"
      },
      "measure": {
        "darwin": [
          "{home}/.npm"
        ],
        "linux": [
          "{home}/.npm"
        ],
        "win32": [
          "{localappdata}/npm-cache"
        ]
      },
      "clean": {
        "executable": "npm",
        "args": [
          "cache",
          "clean",
          "--force"
        ]
      },
      "recreate": "Packages download again on the next install.",
      "tier": "safe"
    },
    {
      "id": "pnpm",
      "name": "pnpm store",
      "category": "dev-cache",
      "platforms": [
        "darwin",
        "linux",
        "win32"
      ],
      "detect": {
        "executable": "pnpm"
      },
      "measure": {
        "darwin": [
          "{home}/Library/pnpm/store"
        ],
        "linux": [
          "{home}/.local/share/pnpm/store"
        ],
        "win32": [
          "{localappdata}/pnpm/store"
        ]
      },
      "clean": {
        "executable": "pnpm",
        "args": [
          "store",
          "prune"
        ]
      },
      "recreate": "Unreferenced packages download again when a project needs them.",
      "tier": "safe"
    },
    {
